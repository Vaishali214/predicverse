// PredicVerse — Prisma Schema
// Full relational database design with PostgreSQL
// Local development: Embedded PostgreSQL (auto-started by server)
// Production: Cloud PostgreSQL (Neon / Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// USER & AUTHENTICATION
// ============================================================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  profile        UserProfile?
  travelDNA      TravelDNA?
  trips          Trip[]
  wishlistItems  WishlistItem[]
  passportStamps PassportStamp[]
  collaborations TripCollaborator[]

  @@map("users")
}

// ============================================================
// USER PROFILE
// ============================================================

model UserProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  travelStyle           String?
  interests             String   @default("[]") // JSON array string
  preferredBudget       String?
  preferredDestinations String   @default("[]") // JSON array string
  bio                   String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// ============================================================
// TRAVEL DNA
// ============================================================

model TravelDNA {
  id          String   @id @default(cuid())
  userId      String   @unique

  // Category scores (0-100)
  culture     Int      @default(75)
  food        Int      @default(82)
  adventure   Int      @default(65)
  nature      Int      @default(70)
  history     Int      @default(78)
  relaxation  Int      @default(60)
  nightlife   Int      @default(50)
  luxury      Int      @default(45)
  budget      Int      @default(72)
  photography Int      @default(68)

  // Calculated archetype (e.g. "THE CULTURAL EXPLORER")
  archetype   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("travel_dna")
}

// ============================================================
// TRIPS
// ============================================================

model Trip {
  id          String    @id @default(cuid())
  userId      String
  title       String
  destination String
  country     String?
  city        String?
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  days        Int?
  travelers   Int?
  travelStyle String?
  interests   String    @default("[]") // JSON array string
  description String?
  itinerary   String?   // Generated itinerary text (from old system)
  status      String    @default("PLANNED")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  itineraries   Itinerary[]
  collaborators TripCollaborator[]
  shareLinks    TripShareLink[]

  @@index([userId])
  @@map("trips")
}

// ============================================================
// ITINERARY (days within a trip)
// ============================================================

model Itinerary {
  id          String   @id @default(cuid())
  tripId      String
  dayNumber   Int
  date        DateTime?
  title       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  trip  Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items ItineraryItem[]

  @@index([tripId])
  @@map("itineraries")
}

// ============================================================
// ITINERARY ITEMS (individual activities within a day)
// ============================================================

model ItineraryItem {
  id            String   @id @default(cuid())
  itineraryId   String
  title         String
  description   String?
  location      String?
  category      String?
  startTime     String?
  endTime       String?
  estimatedCost Float?
  latitude      Float?
  longitude     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@index([itineraryId])
  @@map("itinerary_items")
}

// ============================================================
// WISHLIST
// ============================================================

model WishlistItem {
  id              String   @id @default(cuid())
  userId          String
  destinationType String   // 'country' | 'state' | 'city'
  destinationId   String
  destinationName String
  category        String?
  description     String?
  imageUrl        String?
  latitude        Float?
  longitude       Float?
  createdAt       DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Prevent duplicate wishlist entries for same user + destination
  @@unique([userId, destinationId])
  @@index([userId])
  @@map("wishlist_items")
}

// ============================================================
// PASSPORT STAMPS
// ============================================================

model PassportStamp {
  id              String   @id @default(cuid())
  userId          String
  country         String?
  city            String?
  destination     String   // display name
  destinationId   String
  destinationType String   // 'country' | 'state' | 'city'
  stampDate       DateTime @default(now())
  flag            String?
  visitCount      Int      @default(1) // supports future multi-visit
  createdAt       DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Unique stamp per user per destination (first visit)
  @@unique([userId, destinationId])
  @@index([userId])
  @@map("passport_stamps")
}

// ============================================================
// HIDDEN GEMS (destination-level data, not per-user)
// ============================================================

model HiddenGem {
  id            String   @id @default(cuid())
  destination   String
  country       String
  city          String?
  codename      String   // "The Whispering Pass of..."
  description   String?
  location      String?
  crowdLevel    String?
  estimatedCost String?
  rating        Float?
  category      String?
  latitude      Float?
  longitude     Float?
  imageUrl      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("hidden_gems")
}

// ============================================================
// TRIP COLLABORATORS
// ============================================================

model TripCollaborator {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  role      String   @default("VIEWER") // "OWNER" | "EDITOR" | "VIEWER"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([tripId])
  @@index([userId])
  @@map("trip_collaborators")
}

// ============================================================
// TRIP SHARE LINKS
// ============================================================

model TripShareLink {
  id        String    @id @default(cuid())
  tripId    String
  token     String    @unique
  role      String    @default("VIEWER") // "VIEWER" | "EDITOR"
  expiresAt DateTime?
  isRevoked Boolean   @default(false)
  createdAt DateTime  @default(now())

  // Relations
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([token])
  @@map("trip_share_links")
}
