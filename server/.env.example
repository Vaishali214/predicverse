# ============================================================
# PredicVerse — Server Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# PostgreSQL Database Connection
# Local development: postgresql://postgres:postgres_password@127.0.0.1:5432/predicverse?schema=public
# Production (Neon/Supabase): postgresql://user:password@host:5432/dbname?schema=public&sslmode=require
DATABASE_URL=""
DIRECT_URL=""

# JWT Authentication Secret (MUST be unique and strong in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=""

# Google Gemini AI API Key
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Gemini Model (default: gemini-1.5-flash)
GEMINI_MODEL="gemini-1.5-flash"

# Server Port
PORT=3001

# Node Environment: development | production
NODE_ENV=development

# Frontend Origin for CORS (comma-separated for multiple domains)
# Examples: https://predicverse.vercel.app,https://www.predicverse.com
CLIENT_ORIGIN=""
