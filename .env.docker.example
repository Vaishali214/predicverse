# ============================================================
# PredicVerse — Production Docker Environment Configuration
# ============================================================

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=predicverse_db_secret_pass_2026
POSTGRES_DB=predicverse
POSTGRES_PORT=5432

# Client Frontend Port (80 for standard web traffic, or 3000 / 8080)
CLIENT_PORT=80

# Backend Secrets
# Generate your own unique 128-char hex secret:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=c87bf15694c03ba8651a2d1e0892095cf0d05daeb5cbebf0dfb4618774e1773010b91d4e7d23d8c253818610534c0eec6b9be20d7dae6ad1c8be40901eefb5da

# Optional Google Gemini AI API Key (from https://aistudio.google.com/app/apikey)
# If empty, the system automatically uses the intelligent deterministic itinerary generator
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# CORS Allowed Origins
# If deploying to a domain, add your domain here (comma-separated):
# CLIENT_ORIGIN=http://your-vps-ip,https://predicverse.yourdomain.com
CLIENT_ORIGIN=http://localhost,http://localhost:80,http://localhost:3000
